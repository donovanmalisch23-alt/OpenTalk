// SPDX-License-Identifier: GPL-3.0-only
// Windows resources for OpenTalk.exe: the icon Explorer shows, and the details in
// the file's Properties. Generated into the build folder by CMake.
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/opentalk.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "The OpenTalk contributors"
            VALUE "FileDescription", "OpenTalk"
            VALUE "FileVersion", "@OPENTALK_DISPLAY_VERSION@"
            VALUE "InternalName", "OpenTalk"
            VALUE "LegalCopyright", "GNU General Public License version 3"
            VALUE "OriginalFilename", "OpenTalk.exe"
            VALUE "ProductName", "OpenTalk"
            VALUE "ProductVersion", "@OPENTALK_DISPLAY_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
